{{ define "main" }}
<article class="content-card">
    <header class="member-header">
        <h1 class="member-name">{{ .Title }}</h1>
        <div class="member-meta">
            {{ if .Params.uid }}<span>UID: {{ .Params.uid }}</span>{{ end }}
            {{ if .Params.dateline }}<span>註冊：{{ .Params.dateline }}</span>{{ end }}
            {{ if .Params.lastlogin }}<span>最後登入：{{ .Params.lastlogin }}</span>{{ end }}
            {{ if .Params.friendnum }}<span>好友：{{ .Params.friendnum }} 位</span>{{ end }}
        </div>
    </header>

    {{ $uid := .Params.uid }}
    {{ $uidStr := printf "%v" $uid }}

    {{/* ===== 會員空間 ===== */}}
    {{ $fields := index hugo.Data.member_fields $uidStr }}
    {{ if $fields }}
        {{ if $fields.note }}
            <h2 class="section-title">📝 個人簽名</h2>
            <div class="member-note">{{ $fields.note | safeHTML }}</div>
        {{ end }}
        {{ if $fields.spacenote }}
            <h2 class="section-title">📢 空間公告</h2>
            <div class="member-spacenote">{{ $fields.spacenote | safeHTML }}</div>
        {{ end }}
        {{ if or $fields.resideprovince $fields.residecity }}
            <h2 class="section-title">📍 居住地</h2>
            <p>{{ $fields.resideprovince }}{{ $fields.residecity }}</p>
        {{ end }}
        {{ if $fields.birthyear }}
            <h2 class="section-title">🎂 生日</h2>
            <p>{{ $fields.birthyear }}-{{ printf "%02d" $fields.birthmonth }}-{{ printf "%02d" $fields.birthday }}</p>
        {{ end }}
    {{ end }}

    {{/* ===== 日誌 ===== */}}
    {{ $myBlogs := where hugo.Data.blogs "uid" $uid }}
    {{ if $myBlogs }}
        <h2 class="section-title">📝 日誌（{{ len $myBlogs }} 篇）</h2>
        <ul class="blog-list">
            {{ range $myBlogs }}
                <li class="blog-list-item">
                    <span class="blog-title">{{ .title }}</span>
                    <span class="blog-author">{{ .dateline }}</span>
                </li>
            {{ end }}
        </ul>
    {{ end }}

    {{/* ===== 好友清單 ===== */}}
    {{ $friends := index hugo.Data.friends $uidStr }}
    {{ if $friends }}
        <h2 class="section-title">👥 好友（{{ len $friends }} 位）</h2>
        <ul class="friend-list">
            {{ range first 50 $friends }}
                <li><a href="/members/{{ . }}/">{{ . }}</a></li>
            {{ end }}
        </ul>
    {{ end }}

    {{/* ===== 留言板 ===== */}}
    {{ $comments := index hugo.Data.comments $uidStr }}
    {{ if $comments }}
        <h2 class="section-title">💬 留言板（{{ len $comments }} 則）</h2>
        <ul class="comment-list">
            {{ range $comments }}
                <li class="comment-item">
                    <div class="comment-meta">
                        <span class="comment-author">{{ .author }}</span>
                        <span class="comment-date">{{ .dateline }}</span>
                    </div>
                    <div class="comment-message">{{ .message | safeHTML }}</div>
                </li>
            {{ end }}
        </ul>
    {{ end }}

</article>
{{ end }}